{
  "name": "berrytrace",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "npm run dev",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "vite preview --outDir dist/analog/public",
    "i18n:extract": "localize-extract -r . -s 'dist/client/assets/*.js' -f json -o src/i18n/messages.json -l uk --useSourceMaps false"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.7.5",
    "@analogjs/router": "^2.7.5",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/localize": "^22.2.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "front-matter": "^4.0.2",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.5",
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^22.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
